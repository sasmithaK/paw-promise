# Local Supabase defaults are printed by `npm run supabase:start`.
# Hosted development values come from the development project's Connect dialog.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-or-development-publishable-key

# Never expose a Supabase secret/service-role key through NEXT_PUBLIC_*.
# A server-only secret is intentionally not required by the current foundation.
